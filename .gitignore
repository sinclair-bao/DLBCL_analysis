# =============================================
# autoPET 第三方模型与代码（体积大，不同步）
# =============================================
autoPET/

# =============================================
# 数据与结果目录（本地保留，不上传）
# 已经入库的 .gitkeep 和讲课材料仍保留在历史中
# =============================================
data/**
!data/**/
!data/**/.gitkeep
results/**
!results/**/
!results/**/.gitkeep

# =============================================
# 医学影像与 DICOM 相关
# =============================================
*.nii
*.nii.gz
*.dcm
*.dicom
*.img
*.hdr
*.mha
*.mhd
*.nrrd
DICOMDIR*
DIR_INFO.TXT

# =============================================
# 日志与临时文件
# =============================================
logs/**
!logs/.gitkeep
*.log
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# =============================================
# 环境与本地密钥
# =============================================
.env
.venv/
venv/
*.mat
*.pth
*.pt
*.h5
*.hdf5
*.ckpt
*.zip
*.rar
*.tar
*.tar.gz
*.7z
